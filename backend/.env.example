# --- Postgres (Northflank addon injects these; local defaults match docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Newpassword
POSTGRES_DB=noah

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Northflank TLS Redis uses rediss:// — ssl_cert_reqs is added automatically for Celery.
# REDIS_SSL_CERT_REQS=CERT_REQUIRED
CELERY_QUEUE=default

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=change-me-in-production
# Cross-origin HTTPS (e.g. interview.noah.support + API on code.run): auto SameSite=None; Secure
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=true

# --- LiveKit (use LiveKit Cloud in production) ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- AI providers ---
OPENAI_API_KEY=
ELEVEN_API_KEY=
GROQ_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=interviewer-docs

# --- Agent / worker ---
SUMMARY_AMOUNT=5
CLEAN_DATABASE_ON_EXIT=true
BPMN_REDIS_TTL_S=172800
